digraph "catalog" {

splines  = ortho;
fontname = "Inconsolata";

node [colorscheme = ylgnbu4];
edge [colorscheme = dark28, dir = both];

category                       [shape = record, label = "{ category |  code : varchar(255)\l  name : varchar(255)\l  description : text\l  parent_id : bigint\l  allow_multiple_categories : boolean\l  inherit_features : boolean\l  active : boolean\l  sequence : integer\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l  dtype : varchar(31)\l| id : bigint\l }"];
category_feature_template      [shape = record, label = "{ category_feature_template |  category_id : bigint\l  code : varchar(255)\l  name : varchar(255)\l  description : text\l  feature_type : varchar(50)\l  attribute_type : varchar(50)\l  validation_pattern : varchar(255)\l  min_value : numeric\l  max_value : numeric\l  allowed_values : text\l  unit : varchar(50)\l  visible : boolean\l  editable : boolean\l  searchable : boolean\l  comparable : boolean\l  mandatory : boolean\l  multi_valued : boolean\l  metadata : jsonb\l  display_order : integer\l  is_required : boolean\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
class_attribute_assignments    [shape = record, label = "{ class_attribute_assignments |  classification_class_id : bigint\l  classification_attribute_id : bigint\l  unit : varchar(50)\l  attribute_type : varchar(50)\l  mandatory : boolean\l  multi_valued : boolean\l  sequence : integer\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
classification_attribute       [shape = record, label = "{ classification_attribute |  code : varchar(255)\l  name : varchar(255)\l  description : text\l  attribute_type : varchar(50)\l  validation_pattern : varchar(255)\l  min_value : numeric\l  max_value : numeric\l  unit : varchar(50)\l  visible : boolean\l  editable : boolean\l  searchable : boolean\l  comparable : boolean\l  mandatory : boolean\l  multi_valued : boolean\l  metadata : jsonb\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
classification_attribute_value [shape = record, label = "{ classification_attribute_value |  assignment_id : bigint\l  value : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
classification_class           [shape = record, label = "{ classification_class |  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
classification_class_metadata  [shape = record, label = "{ classification_class_metadata |  value : text\l| class_id : bigint\l  key : varchar(255)\l }"];
enum_value                     [shape = record, label = "{ enum_value |  code : varchar(255)\l  sort_order : integer\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
enum_value_translation         [shape = record, label = "{ enum_value_translation |  enum_value_id : bigint\l  language_code : varchar(10)\l  value : varchar(255)\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
feature_value_event            [shape = record, label = "{ feature_value_event |  feature_id : bigint\l  product_id : bigint\l  old_value : text\l  new_value : text\l  event_type : varchar(50)\l  metadata : text\l  timestamp : timestamp\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
product                        [shape = record, label = "{ product |  code : varchar(255)\l  name : varchar(255)\l  description : text\l  product_type : varchar(50)\l  status : varchar(50)\l  metadata : jsonb\l  sku : varchar(255)\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
product_categories             [shape = record, label = "{ product_categories |  product_id : bigint\l  category_id : bigint\l }"];
product_feature                [shape = record, label = "{ product_feature |  product_id : bigint\l  template_id : bigint\l  code : varchar(255)\l  name : varchar(255)\l  description : text\l  feature_type : varchar(50)\l  attribute_type : varchar(50)\l  validation_pattern : varchar(255)\l  min_value : varchar(255)\l  max_value : varchar(255)\l  allowed_values : text\l  default_value : varchar(255)\l  unit_id : bigint\l  metadata : jsonb\l  required : boolean\l  visible : boolean\l  editable : boolean\l  searchable : boolean\l  comparable : boolean\l  multi_valued : boolean\l  values : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
product_feature_value          [shape = record, label = "{ product_feature_value |  product_id : bigint\l  feature_id : bigint\l  template_id : bigint\l  type : varchar(50)\l  unit : varchar(50)\l  unit_of_measure : varchar(50)\l  status : varchar(50)\l  validation_status : varchar(50)\l  validation_pattern : varchar(255)\l  validation_message : text\l  attribute_values : jsonb\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];
unit                           [shape = record, label = "{ unit |  code : varchar(50)\l  name : varchar(255)\l  description : text\l  created_date : timestamp\l  last_modified_date : timestamp\l| id : bigint\l }"];
unit_of_measure                [shape = record, label = "{ unit_of_measure |  code : varchar(50)\l  name : varchar(255)\l  description : text\l  base_unit : varchar(50)\l  conversion_factor : numeric\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : bigint\l }"];

category                       -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "parent_id:id", headlabel = ""];
category_feature_template      -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "category_id:id", headlabel = ""];
class_attribute_assignments    -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "classification_class_id:id", headlabel = ""];
class_attribute_assignments    -> classification_attribute       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "classification_attribute_id:id", headlabel = ""];
class_attribute_assignments    -> classification_class           [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "classification_class_id:id", headlabel = ""];
classification_attribute_value -> class_attribute_assignments    [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "assignment_id:id", headlabel = ""];
classification_class           -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "id", headlabel = ""];
classification_class_metadata  -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "class_id:id", headlabel = ""];
enum_value_translation         -> enum_value                     [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "enum_value_id:id", headlabel = ""];
feature_value_event            -> product                        [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
feature_value_event            -> product_feature                [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "feature_id:id", headlabel = ""];
product_categories             -> category                       [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "category_id:id", headlabel = ""];
product_categories             -> product                        [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature                -> category_feature_template      [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "template_id:id", headlabel = ""];
product_feature                -> product                        [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature                -> unit                           [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "unit_id:id", headlabel = ""];
product_feature_value          -> product                        [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature_value          -> product_feature                [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "feature_id:id", headlabel = ""];

}
