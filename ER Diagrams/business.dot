digraph "business" {

splines  = ortho;
fontname = "Inconsolata";

node [colorscheme = ylgnbu4];
edge [colorscheme = dark28, dir = both];

Merchant                  [shape = record, label = "{ Merchant |  code : varchar(255)\l  name : varchar(255)\l  description : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
catalog                   [shape = record, label = "{ catalog |  code : varchar(255)\l  business_id : uuid\l  name : varchar(255)\l  description : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
catalog_category          [shape = record, label = "{ catalog_category |  primary_category : boolean\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| catalog_id : uuid\l  category_id : uuid\l }"];
category                  [shape = record, label = "{ category |  type : varchar(50)\l  business_id : uuid\l  catalog_id : uuid\l  parent_id : uuid\l  name : varchar(255)\l  inherit_features : boolean\l  description : text\l  code : varchar(255)\l  level : integer\l  status : varchar(50)\l  metadata : jsonb\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
category_feature_template [shape = record, label = "{ category_feature_template |  name : varchar(255)\l  description : text\l  code : varchar(255)\l  feature_type : varchar(50)\l  validation_pattern : varchar(255)\l  min_value : varchar(255)\l  max_value : varchar(255)\l  allowed_values : text\l  attribute_type : varchar(50)\l  comparable : boolean\l  visible : boolean\l  searchable : boolean\l  editable : boolean\l  multi_valued : boolean\l  default_value : varchar(255)\l  unit_id : uuid\l  metadata : jsonb\l  required : boolean\l  category_id : uuid\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
product                   [shape = record, label = "{ product |  business_id : uuid\l  catalog_id : uuid\l  name : varchar(255)\l  description : text\l  code : varchar(255)\l  product_type : varchar(50)\l  status : varchar(50)\l  metadata : jsonb\l  sku : varchar(255)\l  price : numeric(19,4)\l  unit_of_measure_id : uuid\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
product_attribute         [shape = record, label = "{ product_attribute |  created_date : timestamp(6)\l  last_modified_date : timestamp(6)\l  product_id : uuid\l  attribute_name : varchar(255)\l  attribute_value : varchar(255)\l  created_by : varchar(255)\l  last_modified_by : varchar(255)\l  unit_of_measure : varchar(255)\l| id : uuid\l }"];
product_categories        [shape = record, label = "{ product_categories |  primary_category : boolean\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| product_id : uuid\l  category_id : uuid\l }"];
product_feature           [shape = record, label = "{ product_feature |  name : varchar(255)\l  description : text\l  code : varchar(255)\l  feature_type : varchar(50)\l  validation_pattern : varchar(255)\l  min_value : varchar(255)\l  max_value : varchar(255)\l  allowed_values : text\l  attribute_type : varchar(50)\l  comparable : boolean\l  visible : boolean\l  searchable : boolean\l  editable : boolean\l  multi_valued : boolean\l  default_value : varchar(255)\l  unit_id : uuid\l  metadata : jsonb\l  required : boolean\l  product_id : uuid\l  template_id : uuid\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
product_feature_value     [shape = record, label = "{ product_feature_value |  type : varchar(50)\l  product_id : uuid\l  attribute_values : jsonb\l  metadata : jsonb\l  status : varchar(50)\l  template_id : uuid\l  feature_id : uuid\l  unit : varchar(255)\l  unit_of_measure : varchar(255)\l  validation_message : varchar(255)\l  validation_pattern : varchar(255)\l  validation_status : varchar(50)\l  value : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
site                      [shape = record, label = "{ site |  business_id : uuid\l  name : varchar(255)\l  domain : varchar(255)\l  locale : varchar(10)\l  currency : varchar(3)\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
site_catalog              [shape = record, label = "{ site_catalog |  is_default : boolean\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| site_id : uuid\l  catalog_id : uuid\l }"];
unit                      [shape = record, label = "{ unit |  symbol : varchar(10)\l  code : varchar(255)\l  name : varchar(255)\l  type : varchar(100)\l  description : text\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];
unit_of_measure           [shape = record, label = "{ unit_of_measure |  code : varchar(255)\l  name : varchar(255)\l  type : varchar(100)\l  active : boolean\l  display_symbol : varchar(10)\l  metadata : varchar(255)\l  description : text\l  unit_id : uuid\l  conversion_factor : numeric(19,4)\l  base_unit_id : uuid\l  created_by : varchar(255)\l  created_date : timestamp\l  last_modified_by : varchar(255)\l  last_modified_date : timestamp\l| id : uuid\l }"];

catalog                   -> Merchant                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "business_id:id", headlabel = ""];
catalog_category          -> catalog                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "catalog_id:id", headlabel = ""];
catalog_category          -> category                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "category_id:id", headlabel = ""];
category                  -> Merchant                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "business_id:id", headlabel = ""];
category                  -> catalog                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "catalog_id:id", headlabel = ""];
category                  -> category                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "parent_id:id", headlabel = ""];
category_feature_template -> category                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "category_id:id", headlabel = ""];
category_feature_template -> unit                      [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "unit_id:id", headlabel = ""];
product                   -> Merchant                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "business_id:id", headlabel = ""];
product                   -> catalog                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "catalog_id:id", headlabel = ""];
product                   -> unit_of_measure           [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "unit_of_measure_id:id", headlabel = ""];
product_attribute         -> product                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_categories        -> category                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "category_id:id", headlabel = ""];
product_categories        -> product                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature           -> category_feature_template [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "template_id:id", headlabel = ""];
product_feature           -> product                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature           -> unit                      [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "unit_id:id", headlabel = ""];
product_feature_value     -> category_feature_template [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "template_id:id", headlabel = ""];
product_feature_value     -> product                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "product_id:id", headlabel = ""];
product_feature_value     -> product_feature           [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "feature_id:id", headlabel = ""];
site                      -> Merchant                  [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "business_id:id", headlabel = ""];
site_catalog              -> catalog                   [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "catalog_id:id", headlabel = ""];
site_catalog              -> site                      [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "site_id:id", headlabel = ""];
unit_of_measure           -> unit                      [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "unit_id:id", headlabel = ""];
unit_of_measure           -> unit_of_measure           [color = "#595959", style = solid , arrowtail = none    , arrowhead = normal  , taillabel = "", label = "base_unit_id:id", headlabel = ""];

}
