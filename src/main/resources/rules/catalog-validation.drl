package rules;

import com.scaler.entity.Catalog;
import com.scaler.validation.fact.CatalogValidationFact;
import java.util.List;
import java.util.ArrayList;

dialect "java"

rule "Validate Catalog Name"
    salience 100
when
    $fact: CatalogValidationFact(catalog != null && (catalog.getName() == null || catalog.getName().trim().isEmpty()))
then
    $fact.addError("Catalog name cannot be empty");
end

rule "Validate Catalog Description"
    salience 100
when
    $fact: CatalogValidationFact(catalog != null && (catalog.getDescription() == null || catalog.getDescription().trim().isEmpty()))
then
    $fact.addError("Catalog description cannot be empty");
end

rule "Validate Catalog Status"
    salience 100
when
    $fact: CatalogValidationFact(catalog != null && catalog.getStatus() == null)
then
    $fact.addError("Catalog status cannot be null");
end
