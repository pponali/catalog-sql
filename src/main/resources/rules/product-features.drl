package rules;

import com.scaler.entity.ProductFeature;
import com.scaler.entity.FeatureTemplate;
import com.scaler.validation.fact.ProductFeatureValidationFact;
import java.math.BigDecimal;
import java.util.Arrays;
import java.util.List;
import java.util.ArrayList;

dialect "java"

// Constants
declare CategoryIds
    FASHION: String = "0t1u2v3w-4x5y-6z7a-8b9c-0d1e2f3g4h5i"
    MEDICINE: String = "2v3w4x5y-6z7a-8b9c-0d1e-2f3g4h5i6j7k"
    GROCERY: String = "3w4x5y6z-7a8b-9c0d-1e2f-3g4h5i6j7k8l"
    ELECTRONICS: String = "4x5y6z7a-8b9c-0d1e-2f3g-4h5i6j7k8l9m"
end

// Size validation for fashion products
rule "Validate Fashion Size"
    salience 100
when
    $fact: ProductFeatureValidationFact(
        feature != null && 
        feature.getTemplate() != null && 
        feature.getTemplate().getCode() == "SIZE" &&
        feature.getTemplate().getCategoryId() == CategoryIds.FASHION &&
        feature.getValue() != null &&
        !Arrays.asList("XS", "S", "M", "L", "XL", "XXL").contains(feature.getValue())
    )
then
    $fact.addError("Invalid size value for feature " + $fact.getFeature().getCode());
end

// Dosage validation for medicines
rule "Validate Medicine Dosage"
    salience 100
when
    $fact: ProductFeatureValidationFact(
        feature != null && 
        feature.getTemplate() != null && 
        feature.getTemplate().getCode() == "DOSAGE" &&
        feature.getTemplate().getCategoryId() == CategoryIds.MEDICINE &&
        feature.getValue() != null &&
        (
            !feature.getValue().matches("^\\d+(\\.\\d+)?$") || 
            new BigDecimal(feature.getValue()).compareTo(new BigDecimal("0.1")) < 0 || 
            new BigDecimal(feature.getValue()).compareTo(new BigDecimal("1000.0")) > 0
        )
    )
then
    $fact.addError("Dosage must be between 0.1 and 1000.0 mg");
end

// Weight validation for grocery products
rule "Validate Grocery Weight"
    salience 100
when
    $fact: ProductFeatureValidationFact(
        feature != null && 
        feature.getTemplate() != null && 
        feature.getTemplate().getCode() == "WEIGHT" &&
        feature.getTemplate().getCategoryId() == CategoryIds.GROCERY &&
        feature.getValue() != null &&
        (
            !feature.getValue().matches("^\\d+(\\.\\d+)?$") || 
            new BigDecimal(feature.getValue()).compareTo(new BigDecimal("0.001")) < 0 || 
            new BigDecimal(feature.getValue()).compareTo(new BigDecimal("1000.0")) > 0
        )
    )
then
    $fact.addError("Weight must be between 0.001 and 1000.0 kg");
end

// Storage validation for electronics
rule "Validate Electronics Storage"
    salience 100
when
    $fact: ProductFeatureValidationFact(
        feature != null && 
        feature.getTemplate() != null && 
        feature.getTemplate().getCode() == "STORAGE" &&
        feature.getTemplate().getCategoryId() == CategoryIds.ELECTRONICS &&
        feature.getValue() != null &&
        !Arrays.asList("64", "128", "256", "512", "1024").contains(feature.getValue())
    )
then
    $fact.addError("Invalid storage capacity for feature " + $fact.getFeature().getCode());
end

// Color validation for all products
rule "Validate Product Color"
    salience 100
when
    $fact: ProductFeatureValidationFact(
        feature != null && 
        feature.getTemplate() != null && 
        feature.getTemplate().getCode() == "COLOR" &&
        feature.getValue() != null &&
        !feature.getValue().matches("^[A-Za-z\\s-]{2,50}$")
    )
then
    $fact.addError("Color must be 2-50 characters long and contain only letters, spaces, and hyphens for feature " + $fact.getFeature().getCode());
end
