package rules;

import com.scaler.entity.Channel;
import com.scaler.validation.fact.ChannelValidationFact;
import java.util.List;
import java.util.ArrayList;

dialect "java"

rule "Validate Channel Name"
    salience 100
when
    $fact: ChannelValidationFact(channel != null && (channel.getName() == null || channel.getName().trim().isEmpty()))
then
    $fact.addError("Channel name cannot be empty");
end

rule "Validate Channel Code"
    salience 100
when
    $fact: ChannelValidationFact(channel != null && (channel.getCode() == null || channel.getCode().trim().isEmpty()))
then
    $fact.addError("Channel code cannot be empty");
end

rule "Validate Channel Type"
    salience 100
when
    $fact: ChannelValidationFact(channel != null && channel.getType() == null)
then
    $fact.addError("Channel type cannot be null");
end

rule "Validate Channel Status"
    salience 100
when
    $fact: ChannelValidationFact(channel != null && channel.getStatus() == null)
then
    $fact.addError("Channel status cannot be null");
end
