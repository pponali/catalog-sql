package rules;

import com.scaler.entity.Merchant;
import com.scaler.validation.fact.MerchantValidationFact;
import java.util.List;
import java.util.ArrayList;

dialect "java"

rule "Validate Merchant Name"
    salience 100
when
    $fact: MerchantValidationFact(merchant != null && (merchant.getName() == null || merchant.getName().trim().isEmpty()))
then
    $fact.addError("Merchant name cannot be empty");
end

rule "Validate Merchant Code"
    salience 100
when
    $fact: MerchantValidationFact(merchant != null && (merchant.getCode() == null || merchant.getCode().trim().isEmpty()))
then
    $fact.addError("Merchant code cannot be empty");
end

rule "Validate Merchant Status"
    salience 100
when
    $fact: MerchantValidationFact(merchant != null && merchant.getStatus() == null)
then
    $fact.addError("Merchant status cannot be null");
end

rule "Validate Merchant Contact"
    salience 100
when
    $fact: MerchantValidationFact(merchant != null && (merchant.getContactEmail() == null || merchant.getContactEmail().trim().isEmpty()))
then
    $fact.addError("Merchant contact email cannot be empty");
end
